{
  "appname": "Gameboard",
  "apphost": "",
  "imghost": "",
  "tochost": "",
  "supporthost": "",
  "tocfile": "toc.json",
  "countdownStartSecondsAtMinute": 5,
  "custom_background": "",
  "consoleForgeConfig": {
    "consoleBackgroundStyle": "rgb(0, 0, 0)",
    "defaultConsoleClientType": "vmware",
    "logThreshold": 2,
    "showBrowserNotificationsOnConsoleEvents": true
  },
  "HeaderBarSettings": {
    "enabled": false,
    "banner_background_color": "#d40000ff",
    "classification_text": "",
    "classification_text_color": "#ffffff",
    "classification_text_fontsize": "22",
    "message_text": "",
    "message_text_color": "#ffffff",
    "message_text_fontsize": "18"
  },
  "oidc": {
    "authority": "https://identity.example.com/realms/crucible",
    "client_id": "gameboard-ui",
    "redirect_uri": "https://gameboard.example.com/oidc",
    "silent_redirect_uri": "https://gameboard.example.com/assets/oidc-silent.html",
    "post_logout_redirect_uri": "https://gameboard.example.com",
    "response_type": "code",
    "scope": "openid profile gameboard-api",
    "automaticSilentRenew": true,
    "loadUserInfo": true,
    "useLocalStorage": true,
    "autoLogin": false,
    "autoLogout": true
  }
